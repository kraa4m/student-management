<!DOCTYPE html>
<html>
<head>
  <title>Student Management System</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <header>
    <h1>Student Management System</h1>
    <nav>
      <a href="/">Student List</a>
      <a href="/students/add">Add Student</a>
    </nav>
  </header>

  <div class="container">
    <div class="toolbar">
      <form action="/students/search" method="GET" class="search-form">
        <input type="text" name="keyword" placeholder="Search student...">
        <button type="submit">Search</button>
      </form>

      <a href="/students/add" class="btn">+ Add New Student</a>
    </div>

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Student ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Course</th>
            <th>Year</th>
            <th>Email</th>
            <th>Actions</th> <!-- NEW ACTION HEADER -->
          </tr>
        </thead>
        <tbody>
          <% if (students.length > 0) { %>
            <% students.forEach(student => { %>
              <tr>
                <td><%= student.id %></td>
                <td><%= student.student_id %></td>
                <td><%= student.first_name %></td>
                <td><%= student.last_name %></td>
                <td><%= student.course %></td>
                <td><%= student.year_level %></td>
                <td><%= student.email %></td>
                <td>
                  <form action="/students/delete/<%= student.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this student?');">
                    <button type="submit" style="background-color: #dc2626; padding: 0.35rem 0.75rem; font-size: 0.85rem;">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" style="text-align: center;">No students found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</body>
</html>