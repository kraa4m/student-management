<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>Student Management System</h1>

   
        <div class="toolbar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <a href="/students/add" class="btn btn-primary">+ Add New Student</a>

            <form action="/students/search" method="GET" style="display: flex; gap: 10px;">
                <input 
                    type="text" 
                    name="query" 
                    placeholder="Search by ID, name, or course..." 
                    value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                    style="padding: 8px; border: 1px solid #ccc; border-radius: 4px; width: 250px;"
                >
                <button type="submit" class="btn btn-secondary">Search</button>
                <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                    <a href="/" class="btn btn-secondary">Clear</a>
                <% } %>
            </form>
        </div>


        <% if (students && students.length > 0) { %>
            <table class="table" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #f2f2f2; text-align: left;">
                        <th>Student ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Course</th>
                        <th>Year Level</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach(student => { %>
                        <tr style="border-bottom: 1px solid #ddd;">
                            <td><%= student.student_id %></td>
                            <td><%= student.first_name %></td>
                            <td><%= student.last_name %></td>
                            <td><%= student.course %></td>
                            <td><%= student.year_level %></td>
                            <td><%= student.email %></td>
                            <td style="display: flex; gap: 8px; align-items: center;">
                                <a href="/students/edit/<%= student.id %>" class="btn btn-warning">Edit</a>
                                
                                <form action="/students/delete/<%= student.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this student record?');" style="margin: 0;">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <div class="no-records" style="padding: 20px; text-align: center; background: #f9f9f9; border-radius: 4px;">
                <p>No student records found.</p>
            </div>
        <% } %>
    </div>
</body>
</html>